# Copia este archivo como .env (no se sube al repositorio) y completa los datos.

# Dirección del sistema en XAMPP
URL_BASE=http://localhost/chuchuguaza-barber-shop

# Usuario de pruebas con acceso total (rol Administrador)
TEST_USUARIO=demo_barberia
TEST_CLAVE=escribe-aqui-la-contraseña

# Navegador: chrome o edge
NAVEGADOR=chrome

# 1 = sin ventana (más rápido); 0 = ver el navegador mientras prueba
OCULTO=0

# Pausa en milisegundos entre pasos para poder seguirlos con la vista (0 = sin pausa)
PAUSA_MS=0
