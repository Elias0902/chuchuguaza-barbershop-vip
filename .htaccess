RewriteEngine On
Options -Indexes

# ============================================================
# SEGURIDAD: solo se publican index.php, assets/, landing-chuchuguaza/ y cache_assets/.
# Código, configuración, respaldos, pruebas y credenciales devuelven 403 aunque se
# escriba la ruta exacta (se mira la petición original para no romper las reescrituras).
# ============================================================
RewriteCond %{THE_REQUEST} \s/+(?:[^/\s?]+/+)*?(?:app|bd|config|docs|storage|tests|vendor|\.git)(?:/|\s|\?) [NC,OR]
RewriteCond %{THE_REQUEST} \s/[^\s?]*/(?:\.[^/\s?]+|composer\.(?:json|lock|phar)|credenciales-locales\.txt|README\.md|LICENSE)(?:\s|\?) [NC]
RewriteRule ^ - [F,L]
# (sin RewriteBase: las sustituciones se resuelven relativas a esta carpeta,
#  así el proyecto funciona igual en /chuchuguaza-barber-shop o en la raíz)

# ============================================================
# ESTÁTICOS OPTIMIZADOS: css/js → gzip, imágenes → recompresión
# (vía serve_asset.php, no requiere mod_deflate)
# ============================================================
RewriteCond %{REQUEST_URI} !cache_assets/
RewriteCond %{REQUEST_URI} !\.thumbs/
RewriteCond %{REQUEST_FILENAME} -f
RewriteRule \.(css|js|svg|png|jpe?g|gif)$ app/Utils/serve_asset.php [NC,L]

# Front controller
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME} !-f
RewriteRule ^ index.php [QSA,L]

# ============================================================
# PERFORMANCE: Cache de navegador (Lighthouse: cache lifetimes)
# ============================================================
<IfModule mod_expires.c>
    ExpiresActive On

    # Imágenes: 1 año
    ExpiresByType image/png  "access plus 1 year"
    ExpiresByType image/jpeg "access plus 1 year"
    ExpiresByType image/gif  "access plus 1 year"
    ExpiresByType image/webp "access plus 1 year"
    ExpiresByType image/svg+xml "access plus 1 year"
    ExpiresByType image/x-icon  "access plus 1 year"

    # Fuentes: 1 año
    ExpiresByType font/woff2 "access plus 1 year"
    ExpiresByType font/woff  "access plus 1 year"
    ExpiresByType font/ttf   "access plus 1 year"
    ExpiresByType application/font-woff2 "access plus 1 year"

    # CSS y JS: 1 mes
    ExpiresByType text/css        "access plus 1 month"
    ExpiresByType text/javascript "access plus 1 month"
    ExpiresByType application/javascript "access plus 1 month"

    # HTML / PHP: sin cache (contenido dinámico)
    ExpiresByType text/html "access plus 0 seconds"
</IfModule>

<IfModule mod_headers.c>
    # Cache-Control inmutable para estáticos versionables
    <FilesMatch "\.(png|jpe?g|gif|webp|svg|ico|woff2?|ttf)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>
    <FilesMatch "\.(css|js)$">
        Header set Cache-Control "public, max-age=2592000"
    </FilesMatch>

    # Seguridad básica (Lighthouse: Best Practices)
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set X-Content-Type-Options "nosniff"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

# ============================================================
# PERFORMANCE: Compresión gzip/deflate
# ============================================================
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/css text/javascript
    AddOutputFilterByType DEFLATE application/javascript application/json
    AddOutputFilterByType DEFLATE image/svg+xml
    AddOutputFilterByType DEFLATE font/ttf font/woff font/woff2
</IfModule>