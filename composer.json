{
    "name": "chuchuguaza/barber-shop",
    "description": "Sistema de gestión interna de Chuchuguaza Barbershop (PHP MVC con PDO).",
    "type": "project",
    "license": "proprietary",
    "authors": [
        {
            "name": "Elias Armas",
            "homepage": "https://eliasarmas.dev",
            "role": "Autor"
        }
    ],
    "require": {
        "php": ">=8.1",
        "ext-fileinfo": "*",
        "ext-pdo": "*",
        "phpmailer/phpmailer": "^6.9",
        "setasign/fpdf": "^1.8"
    },
    "autoload": {
        "psr-4": {
            "App\\Core\\": "app/core/",
            "App\\Controllers\\": "app/controllers/",
            "App\\Models\\": "app/models/",
            "App\\Helpers\\": "app/helpers/"
        }
    },
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true
    }
}
